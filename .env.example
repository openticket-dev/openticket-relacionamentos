# ===============================================================
# relacionamentos-web — Environment Variables
# Copie para .env.local para dev local
# Em prod: usar Railway secrets / Google Secret Manager
# ===============================================================

# --- Next.js -------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32

# --- BasePath (staging) --------------------------------------
# Em staging dev.openticket.com.br/relacionamentos aponta pra ca
NEXT_PUBLIC_BASE_PATH=

# --- API Gateway ---------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
INTERNAL_GRAPHQL_URL=http://api-gateway:4000/graphql

# --- Shell + API ---------------------------------------------
SHELL_AUTH_URL=http://localhost:3000
API_GATEWAY_URL=http://localhost:4000

# --- Keycloak Auth -------------------------------------------
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=openticket
KEYCLOAK_CLIENT_ID=openticket-relacionamentos
KEYCLOAK_CLIENT_SECRET=your-keycloak-client-secret-here

NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=openticket
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=openticket-relacionamentos

# --- Realtime (chat) -----------------------------------------
NEXT_PUBLIC_SOCKET_URL=http://localhost:4001

# --- Storage (R2) --------------------------------------------
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret
R2_BUCKET=openticket-relacionamentos-media

# --- App Config ----------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:4214
NODE_ENV=development
